# Used by the database container.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medical_db

# Used by tools you run on your own machine (pytest, alembic).
DATABASE_URL=postgresql+psycopg://admin:change-me@localhost:5433/medical_db
# Redis is no longer published to your computer, so only the containers use it.
# The value is still needed so the settings load.
REDIS_URL=redis://localhost:6379/0

# Encrypts document text while it waits in the queue. Paste in a key generated by:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit it. The tests use their own temporary key, not this one.
TEXT_ENCRYPTION_KEY=

# Folder for uploaded originals when you run the API outside Docker.
ORIGINALS_DIR=./originals

# Used only by pytest. It must name a database ending in "_test"; the tests
# create it if needed and empty its tables, so it must never be your real one.
TEST_DATABASE_URL=postgresql+psycopg://admin:change-me@localhost:5433/medical_db_test
