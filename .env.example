# Used by the database container.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medical_db

# Used by tools you run on your own machine (pytest, alembic).
DATABASE_URL=postgresql+psycopg://admin:change-me@localhost:5433/medical_db
REDIS_URL=redis://localhost:6379/0

# Used only by pytest. It must name a database ending in "_test"; the tests
# create it if needed and empty its tables, so it must never be your real one.
TEST_DATABASE_URL=postgresql+psycopg://admin:change-me@localhost:5433/medical_db_test
